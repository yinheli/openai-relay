{
  "name": "@yinheli/openai-relay",
  "version": "0.3.0",
  "description": "OpenAI Relay",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/yinheli/openai-relay"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./index.ts --outdir ./dist --target bun --sourcemap && bun x tsc --emitDeclarationOnly",
    "prepublishOnly": "bun run build",
    "start": "bun run index.ts",
    "dev": "bun --watch run index.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "changelog": "git-cliff --latest",
    "changelog:all": "git-cliff --prepend CHANGELOG.md",
    "publish:jsr": "jsr publish",
    "publish:npm": "npm publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "bun-types": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
